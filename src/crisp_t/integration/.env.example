# Microsoft Teams Bot Environment Variables
# Copy this file to .env and fill in the values

# ─────────────────────────────────────────
# Microsoft Teams / Azure Bot Registration
# ─────────────────────────────────────────

# Microsoft App ID (from Azure Bot registration)
TEAMS_APP_ID=your-microsoft-app-id-here

# Microsoft App Password (client secret from Azure App registration)
TEAMS_APP_PASSWORD=your-microsoft-app-password-here

# Optional: Restrict to a single Azure AD tenant (leave blank for multi-tenant)
# TEAMS_APP_TENANT_ID=your-tenant-id-here

# ─────────────────────────────────────────
# CRISP-T Web UI Server
# ─────────────────────────────────────────

# URL where crisp-ui server is running (default: http://127.0.0.1:5000)
CRISP_UI_URL=http://127.0.0.1:5000

# Default AI model for new CRISP-T sessions
CRISP_DEFAULT_MODEL=gpt-4.1

# ─────────────────────────────────────────
# Teams Bot HTTP Server
# ─────────────────────────────────────────

# Port on which the Teams bot webhook server listens (default: 3978)
PORT=3978
