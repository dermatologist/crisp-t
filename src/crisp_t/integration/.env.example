# Microsoft Teams Integration Environment Variables
# Copy this file to .env and fill in your values before starting the bot.

# ─── Microsoft Teams / Azure Bot Service ─────────────────────────────────────

# Azure Bot Registration Application (client) ID
# Obtain from: Azure Portal → App Registrations → your bot app → Overview
TEAMS_APP_ID=your-azure-app-id-here

# Azure Bot Registration client secret
# Obtain from: Azure Portal → App Registrations → your bot app → Certificates & secrets
TEAMS_APP_PASSWORD=your-azure-app-secret-here

# Port the Teams bot webhook server listens on (default: 3978)
PORT=3978

# ─── CRISP-T Configuration ───────────────────────────────────────────────────

# Absolute path to the working directory where CRISP-T reads and writes data.
# The bot will execute CRISP CLI commands relative to this directory.
# Defaults to ./workspace (created automatically if absent)
CRISP_DATA_PATH=./workspace

# Maximum time (seconds) to wait for a CRISP command to complete (default: 300)
CRISP_COMMAND_TIMEOUT=300

# ─── Logging ─────────────────────────────────────────────────────────────────

# Log level: error | warn | info | debug  (default: info)
LOG_LEVEL=info
