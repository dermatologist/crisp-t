# CRISP-T Chat Bot Environment Variables (Teams + Slack)
# Copy this file to .env and fill in the values

# ─────────────────────────────────────────
# Microsoft Teams / Azure Bot Registration
# ─────────────────────────────────────────

# Microsoft App ID (from Azure Bot registration)
TEAMS_APP_ID=your-microsoft-app-id-here

# Microsoft App Password (client secret from Azure App registration)
TEAMS_APP_PASSWORD=your-microsoft-app-password-here

# Optional: Restrict to a single Azure AD tenant (leave blank for multi-tenant)
# TEAMS_APP_TENANT_ID=your-tenant-id-here

# ─────────────────────────────────────────
# Slack App Credentials
# ─────────────────────────────────────────

# Slack Bot User OAuth Token (from Slack App > OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# Slack Signing Secret (from Slack App > Basic Information)
SLACK_SIGNING_SECRET=your-slack-signing-secret-here

# Optional: App-level token for Socket Mode (starts with xapp-)
# Required only if you use Socket Mode instead of HTTP webhooks
# SLACK_APP_TOKEN=xapp-your-app-level-token-here

# ─────────────────────────────────────────
# CRISP-T Web UI Server
# ─────────────────────────────────────────

# URL where crisp-ui server is running (default: http://127.0.0.1:5000)
CRISP_UI_URL=http://127.0.0.1:5000

# Default AI model for new CRISP-T sessions
CRISP_DEFAULT_MODEL=gpt-4.1

# ─────────────────────────────────────────
# Bot HTTP Server
# ─────────────────────────────────────────

# Port on which the bot webhook server listens (default: 3978)
PORT=3978
